# --- bunq (required) ---
# Leave empty on first run; the app will create a sandbox user automatically.
BUNQ_API_KEY=
BUNQ_SANDBOX=true

# --- Anthropic (required) ---
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Pick the latest Sonnet; Claude 4.5 Sonnet is the current default.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- AWS (for Transcribe / Polly / S3; optional for hour-0 health) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=

# --- server ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
