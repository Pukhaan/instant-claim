# Anthropic Claude API — used for vision + reasoning (damage analysis, decision)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API — used for Whisper speech-to-text on voice note
OPENAI_API_KEY=sk-xxx

# bunq sandbox API key — used to issue instant payouts on approval
# Get a sandbox key: https://doc.bunq.com/#/sandbox
BUNQ_API_KEY=sandbox_xxx

# bunq environment — "sandbox" for demo, "production" for real accounts
BUNQ_ENV=sandbox

# Optional: bunq sandbox monetary account ID to pay out FROM
# (leave blank to auto-select first active account on startup)
BUNQ_MONETARY_ACCOUNT_ID=
